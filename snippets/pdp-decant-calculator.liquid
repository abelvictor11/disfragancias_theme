{%- comment -%}
  Calculadora "¿Cuánto rinde tu decant?" — modal del PDP.
  Params: block (settings del bloque decant_calculator), product.
  El disparador se inyecta por JS en la row de cantidad (.quantity_selector).
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign uid = block.id
  assign accent = s.accent_color | default: '#ba7a2d'
  assign link_color = s.link_color | default: '#e24d2b'
  assign dark = '#232323'

  assign gate = s.only_tag | strip
  assign render_block = true
  if gate != blank
    assign render_block = false
    if product.tags contains gate
      assign render_block = true
    endif
  endif
-%}

{%- if render_block -%}
{%- style -%}
  .dc-qty-row { display:flex; align-items:center; flex-wrap:wrap; gap:12px; }
  .dc-qty-row .quantity_selector { margin:0; }
  .dc-trigger { margin-left:auto; background:none; border:0; padding:0; cursor:pointer;
    color:{{ link_color }}; font: inherit; font-weight:600; text-decoration:underline;
    text-underline-offset:3px; white-space:nowrap; }
  .dc-trigger:hover { opacity:.85; }

  #decant-calc-{{ uid }} { --dc-accent: {{ accent }}; --dc-track: #e8e4dc; }
  #decant-calc-{{ uid }} [data-dc-overlay] { position:fixed; inset:0; background:rgba(20,20,20,.55);
    z-index:99998; }
  #decant-calc-{{ uid }} [data-dc-modal] { position:fixed; z-index:99999; top:50%; left:50%;
    transform:translate(-50%,-50%); width:calc(100% - 32px); max-width:540px; max-height:90vh;
    overflow:auto; background:#fff; border:1px solid #ececec; border-radius:20px;
    padding:28px 26px; box-shadow:0 20px 60px rgba(0,0,0,.22); }
  #decant-calc-{{ uid }} .dc-close { position:absolute; top:14px; right:16px; background:none; border:0;
    font-size:26px; line-height:1; cursor:pointer; color:#999; }
  #decant-calc-{{ uid }} .dc-title { font-family: var(--font-heading-family), 'Cinzel', serif;
    font-weight:400; color:{{ dark }}; font-size:26px; margin:0 6px 6px 0; letter-spacing:.01em; }
  #decant-calc-{{ uid }} .dc-sub { color:#8a8a8a; font-size:14px; line-height:1.5; margin:0 0 18px; }

  #decant-calc-{{ uid }} .dc-sizes { display:flex; gap:12px; margin-bottom:22px; }
  #decant-calc-{{ uid }} .dc-size { flex:1; border:1px solid #e3e3e3; background:#f6f6f6; border-radius:12px;
    padding:14px 8px; font-weight:700; font-size:15px; color:{{ dark }}; cursor:pointer; transition:.15s; }
  #decant-calc-{{ uid }} .dc-size:hover { border-color:#cfcfcf; }
  #decant-calc-{{ uid }} .dc-size.is-active { background:{{ dark }}; color:#fff; border-color:{{ accent }};
    box-shadow:0 0 0 2px {{ accent }}; }

  #decant-calc-{{ uid }} .dc-viz { display:flex; align-items:center; gap:14px; margin:6px 0 10px; }
  #decant-calc-{{ uid }} .dc-bottle { flex:0 0 auto; width:52px; height:78px; color:{{ accent }}; }
  #decant-calc-{{ uid }} .dc-dots { display:flex; flex-wrap:wrap; gap:7px; align-content:center; }
  #decant-calc-{{ uid }} .dc-dot { width:14px; height:14px; border-radius:50%; display:inline-block; }
  #decant-calc-{{ uid }} .dc-dot--on { background:{{ accent }}; }
  #decant-calc-{{ uid }} .dc-dot--off { background:transparent; border:2px solid {{ accent }}; }
  #decant-calc-{{ uid }} .dc-legend { display:flex; gap:22px; flex-wrap:wrap; margin:4px 0 20px;
    font-size:13.5px; color:#555; }
  #decant-calc-{{ uid }} .dc-legend span.m { display:inline-flex; align-items:center; gap:8px; }
  #decant-calc-{{ uid }} .dc-legend i { width:12px; height:12px; border-radius:50%; display:inline-block; }
  #decant-calc-{{ uid }} .dc-legend .i-on { background:{{ accent }}; }
  #decant-calc-{{ uid }} .dc-legend .i-off { border:2px solid {{ accent }}; }

  #decant-calc-{{ uid }} .dc-slider-head { display:flex; justify-content:space-between; align-items:baseline;
    margin-bottom:8px; }
  #decant-calc-{{ uid }} .dc-slider-head .lab { color:{{ dark }}; font-size:15px; }
  #decant-calc-{{ uid }} .dc-slider-head .val { font-weight:700; font-size:18px; color:{{ dark }}; }
  #decant-calc-{{ uid }} input[type=range] { -webkit-appearance:none; appearance:none; width:100%;
    height:6px; border-radius:999px; background:var(--dc-track); margin:6px 0 24px; cursor:pointer; }
  #decant-calc-{{ uid }} input[type=range]:focus-visible { outline:2px solid var(--dc-accent); outline-offset:4px; }
  #decant-calc-{{ uid }} input[type=range]::-webkit-slider-runnable-track { height:6px; border-radius:999px; background:transparent; }
  #decant-calc-{{ uid }} input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; appearance:none;
    width:20px; height:20px; border-radius:50%; background:var(--dc-accent); border:3px solid #fff;
    box-shadow:0 1px 5px rgba(0,0,0,.3); margin-top:-7px; }
  #decant-calc-{{ uid }} input[type=range]::-moz-range-track { height:6px; border-radius:999px; background:var(--dc-track); }
  #decant-calc-{{ uid }} input[type=range]::-moz-range-progress { height:6px; border-radius:999px; background:var(--dc-accent); }
  #decant-calc-{{ uid }} input[type=range]::-moz-range-thumb { width:20px; height:20px; border-radius:50%;
    background:var(--dc-accent); border:3px solid #fff; box-shadow:0 1px 5px rgba(0,0,0,.3); }

  #decant-calc-{{ uid }} .dc-tiles { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:16px; }
  #decant-calc-{{ uid }} .dc-tile { background:#f3f3f3; border-radius:14px; padding:16px 14px; }
  #decant-calc-{{ uid }} .dc-tile .big { font-family: var(--font-heading-family), 'Cinzel', serif;
    font-weight:400; font-size:26px; color:{{ dark }}; line-height:1.1; }
  #decant-calc-{{ uid }} .dc-tile .cap { font-size:13px; color:#8a8a8a; margin-top:6px; }
  #decant-calc-{{ uid }} .dc-foot { font-size:13px; color:#8a8a8a; line-height:1.5; margin:0; }

  @media (max-width:460px) {
    #decant-calc-{{ uid }} .dc-tiles { grid-template-columns:1fr 1fr; }
    #decant-calc-{{ uid }} .dc-tile .big { font-size:22px; }
  }
{%- endstyle -%}

{%- comment -%} Datos para el JS {%- endcomment -%}
{%- capture sizes_json -%}
{%- assign sep = '' -%}
{%- for i in (1..3) -%}
  {%- assign lk = 'size' | append: i | append: '_label' -%}
  {%- assign mk = 'size' | append: i | append: '_ml' -%}
  {%- assign pk = 'size' | append: i | append: '_price' -%}
  {%- assign lbl = s[lk] -%}
  {%- if lbl != blank -%}
    {{ sep }}{"label": {{ lbl | json }}, "ml": {{ s[mk] | default: 0 }}, "price": {{ s[pk] | default: 0 }}}
    {%- assign sep = ',' -%}
  {%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- capture variants_json -%}
{%- assign vsep = '' -%}
{%- for v in product.variants -%}
{{ vsep }}{"title": {{ v.title | json }}, "price": {{ v.price }}}{%- assign vsep = ',' -%}
{%- endfor -%}
{%- endcapture -%}

<div data-decant-calc data-uid="{{ uid }}" id="decant-calc-{{ uid }}">
  <script type="application/json" id="decant-calc-data-{{ uid }}">
    {
      "atomsMin": {{ s.atoms_min | default: 15 }},
      "atomsMax": {{ s.atoms_max | default: 18 }},
      "defaultPerDay": {{ s.default_per_day | default: 5 }},
      "maxPerDay": {{ s.max_per_day | default: 20 }},
      "priceSource": {{ s.price_source | default: 'product_variant' | json }},
      "triggerLabel": {{ s.trigger_label | default: '¿Cuánto rinde tu decant?' | json }},
      "productTitle": {{ product.title | json }},
      "notePrefix": {{ s.note_prefix | default: '*Con precios de' | json }},
      "sizes": [{{ sizes_json }}],
      "variants": [{{ variants_json }}]
    }
  </script>

  <div data-dc-overlay hidden></div>
  <div data-dc-modal role="dialog" aria-modal="true" aria-labelledby="dc-title-{{ uid }}" hidden>
    <button type="button" class="dc-close" data-dc-close aria-label="Cerrar">&times;</button>
    <h3 class="dc-title" id="dc-title-{{ uid }}">{{ s.heading | default: '¿Cuánto rinde tu decant?' }}</h3>
    {%- if s.subtitle != blank -%}<p class="dc-sub">{{ s.subtitle }}</p>{%- endif -%}

    <div class="dc-sizes">
      {%- for i in (1..3) -%}
        {%- assign lk = 'size' | append: i | append: '_label' -%}
        {%- assign lbl = s[lk] -%}
        {%- if lbl != blank -%}
          <button type="button" class="dc-size" data-dc-size aria-pressed="false">{{ lbl }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="dc-viz">
      <svg class="dc-bottle" viewBox="0 0 52 78" fill="none" aria-hidden="true">
        <rect x="20" y="2" width="12" height="10" rx="2" fill="currentColor"/>
        <rect x="18" y="12" width="16" height="6" rx="1" fill="currentColor" opacity=".5"/>
        <rect x="10" y="20" width="32" height="54" rx="7" stroke="currentColor" stroke-width="3"/>
        <rect x="15" y="34" width="22" height="35" rx="4" fill="currentColor" opacity=".85"/>
      </svg>
      <div class="dc-dots">
        <span data-dc-dots-sure style="display:contents"></span>
        <span data-dc-dots-extra style="display:contents"></span>
      </div>
    </div>
    <div class="dc-legend">
      <span class="m"><i class="i-on"></i><span data-dc-leg-sure></span></span>
      <span class="m"><i class="i-off"></i><span data-dc-leg-extra></span></span>
    </div>

    <div class="dc-slider-head">
      <span class="lab">{{ s.slider_label | default: 'Atomizaciones que usas al día' }}</span>
      <span class="val" data-dc-perday>5</span>
    </div>
    <input type="range" data-dc-slider min="1" max="20" step="1" value="5" aria-label="{{ s.slider_label | default: 'Atomizaciones que usas al día' }}">

    <div class="dc-tiles">
      <div class="dc-tile"><div class="big" data-dc-total>—</div><div class="cap">{{ s.cap_total | default: 'atomizaciones' }}</div></div>
      <div class="dc-tile"><div class="big" data-dc-weeks>—</div><div class="cap">{{ s.cap_weeks | default: 'de uso diario' }}</div></div>
      <div class="dc-tile"><div class="big" data-dc-ppa>—</div><div class="cap">{{ s.cap_ppa | default: 'por atomización*' }}</div></div>
    </div>
    <p class="dc-foot" data-dc-foot></p>
    <span data-dc-trigger-fallback hidden></span>
  </div>
</div>

<script src="{{ 'pdp-decant-calculator.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
