{%- comment %}
  Bloque de condiciones B2B en el PDP: reemplaza los perks retail.
  Valores globales desde Theme settings (grupo "B2B"). Cada tile se muestra
  solo si tiene valor.
{% endcomment -%}
{%- liquid
  assign c_min = settings.b2b_min_order
  assign c_lead = settings.b2b_lead_time
  assign c_pay = settings.b2b_payment
  assign c_price_label = settings.b2b_pricelist_label
  assign c_price_url = settings.b2b_pricelist_url
  assign t_min = settings.b2b_min_title | default: 'Pedido mínimo'
  assign t_lead = settings.b2b_lead_title | default: 'Despacho'
  assign t_pay = settings.b2b_pay_title | default: 'Pago'
  assign t_price = settings.b2b_pricelist_title | default: 'Lista de precios'
  assign img_min = settings.b2b_min_icon
  assign img_lead = settings.b2b_lead_icon
  assign img_pay = settings.b2b_pay_icon
  assign img_price = settings.b2b_pricelist_icon
  assign has_any = false
  if c_min != blank or c_lead != blank or c_pay != blank or c_price_url != blank
    assign has_any = true
  endif
-%}
{%- if has_any -%}
  {%- capture ic_box %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5L19.2609 9.69588C19.1108 8.72022 18.2713 8 17.2842 8H6.71584C5.7287 8 4.8892 8.72022 4.73909 9.69589L3.35448 18.6959C3.16809 19.9074 4.10545 21 5.33122 21H12"/><path d="M17.5 17L17.5 19"/><path d="M17.5 22.01L17.51 21.9989"/><path d="M14 5C14 3.89543 13.1046 3 12 3C10.8954 3 10 3.89543 10 5"/></svg>{% endcapture -%}
  {%- capture ic_truck %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 19C9.10457 19 10 18.1046 10 17C10 15.8954 9.10457 15 8 15C6.89543 15 6 15.8954 6 17C6 18.1046 6.89543 19 8 19Z" stroke-miterlimit="1.5"/><path d="M18 19C19.1046 19 20 18.1046 20 17C20 15.8954 19.1046 15 18 15C16.8954 15 16 15.8954 16 17C16 18.1046 16.8954 19 18 19Z" stroke-miterlimit="1.5"/><path d="M10.05 17H15V6.6C15 6.26863 14.7314 6 14.4 6H1"/><path d="M5.65 17H3.6C3.26863 17 3 16.7314 3 16.4V11.5"/><path d="M2 9L6 9"/><path d="M15 9H20.6101C20.8472 9 21.0621 9.13964 21.1584 9.35632L22.9483 13.3836C22.9824 13.4604 23 13.5434 23 13.6273V16.4C23 16.7314 22.7314 17 22.4 17H20.5"/><path d="M15 17H16"/></svg>{% endcapture -%}
  {%- capture ic_card %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 13C13.2386 13 11 11.8807 11 10.5C11 9.11929 13.2386 8 16 8C18.7614 8 21 9.11929 21 10.5C21 11.8807 18.7614 13 16 13Z"/><path d="M11 14.5C11 15.8807 13.2386 17 16 17C18.7614 17 21 15.8807 21 14.5"/><path d="M3 9.5C3 10.8807 5.23858 12 8 12C9.12583 12 10.1647 11.814 11.0005 11.5"/><path d="M3 13C3 14.3807 5.23858 15.5 8 15.5C9.12561 15.5 10.1643 15.314 11 15.0002"/><path d="M3 5.5V16.5C3 17.8807 5.23858 19 8 19C9.12563 19 10.1643 18.8139 11 18.5"/><path d="M13 8.5V5.5"/><path d="M11 10.5V18.5C11 19.8807 13.2386 21 16 21C18.7614 21 21 19.8807 21 18.5V10.5"/><path d="M8 8C5.23858 8 3 6.88071 3 5.5C3 4.11929 5.23858 3 8 3C10.7614 3 13 4.11929 13 5.5C13 6.88071 10.7614 8 8 8Z"/></svg>{% endcapture -%}
  {%- capture ic_file %}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h6"/></svg>{% endcapture -%}
  {%- capture icon_min %}{% if img_min != blank %}<img src="{{ img_min | image_url: width: 66 }}" width="22" height="22" loading="lazy" alt="">{% else %}{{ ic_box }}{% endif %}{% endcapture -%}
  {%- capture icon_lead %}{% if img_lead != blank %}<img src="{{ img_lead | image_url: width: 66 }}" width="22" height="22" loading="lazy" alt="">{% else %}{{ ic_truck }}{% endif %}{% endcapture -%}
  {%- capture icon_pay %}{% if img_pay != blank %}<img src="{{ img_pay | image_url: width: 66 }}" width="22" height="22" loading="lazy" alt="">{% else %}{{ ic_card }}{% endif %}{% endcapture -%}
  {%- capture icon_price %}{% if img_price != blank %}<img src="{{ img_price | image_url: width: 66 }}" width="22" height="22" loading="lazy" alt="">{% else %}{{ ic_file }}{% endif %}{% endcapture -%}
  <div class="b2b-conditions">
    {%- if c_min != blank -%}
      <div class="b2b-cond"><span class="b2b-cond__ic">{{ icon_min }}</span><span><span class="b2b-cond__lbl">{{ t_min }}</span><span class="b2b-cond__val">{{ c_min }}</span></span></div>
    {%- endif -%}
    {%- if c_lead != blank -%}
      <div class="b2b-cond"><span class="b2b-cond__ic">{{ icon_lead }}</span><span><span class="b2b-cond__lbl">{{ t_lead }}</span><span class="b2b-cond__val">{{ c_lead }}</span></span></div>
    {%- endif -%}
    {%- if c_pay != blank -%}
      <div class="b2b-cond"><span class="b2b-cond__ic">{{ icon_pay }}</span><span><span class="b2b-cond__lbl">{{ t_pay }}</span><span class="b2b-cond__val">{{ c_pay }}</span></span></div>
    {%- endif -%}
    {%- if c_price_url != blank -%}
      <a class="b2b-cond b2b-cond--link" href="{{ c_price_url }}"{% if c_price_url contains 'http' %} target="_blank" rel="noopener"{% endif %}><span class="b2b-cond__ic">{{ icon_price }}</span><span><span class="b2b-cond__lbl">{{ t_price }}</span><span class="b2b-cond__val b2b-cond__val--link">{{ c_price_label | default: 'Descargar' }}</span></span></a>
    {%- endif -%}
  </div>
{%- endif -%}
