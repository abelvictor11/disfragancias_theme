{%- comment %}
  Matrix de variantes B2B: tabla con SKU, precio ML, mayorista, sugerido
  (metafield custom.precio_sugerido), stock y cantidad por fila + añadir todo.
  Reemplaza el selector de variante para productos de una sola opción.
{% endcomment -%}
{%- comment -%}
  Cantidad por defecto: 1 SOLO si hay una única variante (así basta "Añadir").
  Con varias variantes se deja en 0 para no agregar todas las tallas de golpe.
{%- endcomment -%}
{%- if product.variants.size == 1 %}{% assign b2b_default_qty = 1 %}{% else %}{% assign b2b_default_qty = 0 %}{% endif -%}
<div class="b2b-matrix" data-product-id="{{ product.id }}" data-default-qty="{{ b2b_default_qty }}">
  {%- assign b2b_hint = settings.b2b_matrix_hint | default: 'Variantes de producto — ingresa cantidades y añade todo al carrito' -%}
  {%- if b2b_hint != blank -%}<div class="b2b-matrix__hint">{{ b2b_hint }}</div>{%- endif -%}
  <div class="b2b-matrix__scroll">
    <table class="b2b-matrix__table">
      <thead>
        <tr>
          <th>{{ product.options.first }}</th>
          <th>SKU</th>
          <th class="ta-r">Precio ML</th>
          <th class="ta-r">Mayorista</th>
          <th class="ta-r">Sugerido</th>
          <th class="ta-c">Stock</th>
          <th class="ta-c">Cantidad</th>
          <th class="ta-r">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        {%- for variant in product.variants -%}
          {%- liquid
            assign ml = variant.title | split: ' ' | first | times: 1
            assign sugerido = variant.metafields.custom.precio_sugerido.value
            assign avail = variant.available
          -%}
          <tr class="b2b-row{% unless avail %} is-soldout{% endunless %}" data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}">
            <td class="b2b-row__size">{{ variant.title }}</td>
            <td class="b2b-row__sku" data-label="SKU">{{ variant.sku | default: '—' }}</td>
            <td class="ta-r b2b-row__unit" data-label="Precio ML">{% if ml > 0 %}{{ variant.price | divided_by: ml | money }}{% else %}—{% endif %}</td>
            <td class="ta-r b2b-row__price" data-label="Mayorista">{{ variant.price | money }}</td>
            <td class="ta-r b2b-row__rrp" data-label="Sugerido">{% if sugerido %}{{ sugerido | money }}{% else %}—{% endif %}</td>
            <td class="ta-c b2b-row__stock" data-label="Stock">
              {%- if avail -%}<span class="b2b-stock b2b-stock--ok">{{ 'products.product.in_stock' | t }}</span>
              {%- else -%}<span class="b2b-stock b2b-stock--out">{{ 'products.product.out_of_stock' | t }}</span>{%- endif -%}
            </td>
            <td class="ta-c b2b-row__qtycell" data-label="Cantidad">
              {%- if avail -%}
                <input type="number" class="b2b-qty" min="0" step="1" value="{{ b2b_default_qty }}" inputmode="numeric" aria-label="Cantidad {{ variant.title }}">
              {%- else -%}<span class="b2b-dash">—</span>{%- endif -%}
            </td>
            <td class="ta-r b2b-row__sub" data-sub data-label="Subtotal">{{ 0 | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  <div class="b2b-matrix__bar" data-multi="{% if product.variants.size > 1 %}1{% else %}0{% endif %}">
    {%- comment -%} Escritorio: totales del pedido por filas. {%- endcomment -%}
    <div class="b2b-matrix__totals">
      <div><span class="b2b-lbl">Unidades</span><span class="b2b-val" data-units>0</span></div>
      <div><span class="b2b-lbl">Total mayorista</span><span class="b2b-val" data-total>{{ 0 | money }}</span></div>
    </div>
    {%- comment -%} Móvil: quick-add (selector de variante si hay varias + cantidad). {%- endcomment -%}
    <div class="b2b-qa">
      {%- if product.variants.size > 1 -%}
        <select class="b2b-qa__variant" data-qa-variant aria-label="Presentación">
          {%- for v in product.variants -%}
            <option value="{{ v.id }}" data-price="{{ v.price }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money }}{% unless v.available %} — agotado{% endunless %}</option>
          {%- endfor -%}
        </select>
      {%- else -%}
        {%- assign only = product.variants.first -%}
        <input type="hidden" data-qa-variant value="{{ only.id }}" data-price="{{ only.price }}" data-available="{{ only.available }}">
      {%- endif -%}
      <input type="number" class="b2b-qa__qty" data-qa-qty min="1" step="1" value="1" inputmode="numeric" aria-label="Cantidad">
    </div>
    <button type="button" class="b2b-addall" data-addall disabled>
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
</div>

<script>
(function(){
  var root = document.currentScript.previousElementSibling;
  if(!root || !root.classList.contains('b2b-matrix')) { root = document.querySelector('.b2b-matrix[data-product-id="{{ product.id }}"]'); }
  var fmt = function(cents){
    try { return new Intl.NumberFormat('es-CO',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}',maximumFractionDigits:0}).format(cents/100); }
    catch(e){ return '$' + Math.round(cents/100).toLocaleString('es-CO'); }
  };
  var rows = root.querySelectorAll('.b2b-row');
  var bar = root.querySelector('.b2b-matrix__bar');
  var addBtn = root.querySelector('[data-addall]');
  var defQty = parseInt(root.getAttribute('data-default-qty')) || 0;
  var qaVariant = root.querySelector('[data-qa-variant]');
  var qaQty = root.querySelector('[data-qa-qty]');
  var mq = window.matchMedia('(max-width: 767px)');
  function isMobile(){ return mq.matches; }

  // Variante seleccionada en el quick-add (select o input oculto si es única).
  function qaCurrent(){
    if(!qaVariant) return null;
    if(qaVariant.tagName === 'SELECT'){
      var opt = qaVariant.options[qaVariant.selectedIndex];
      if(!opt) return null;
      return { id: parseInt(opt.value), price: parseInt(opt.getAttribute('data-price'))||0, available: !opt.disabled };
    }
    return { id: parseInt(qaVariant.value), price: parseInt(qaVariant.getAttribute('data-price'))||0, available: qaVariant.getAttribute('data-available') !== 'false' };
  }

  function recalc(){
    var units=0, total=0;
    rows.forEach(function(r){
      var inp = r.querySelector('.b2b-qty');
      var q = inp ? Math.max(0, parseInt(inp.value)||0) : 0;
      var price = parseInt(r.getAttribute('data-price'))||0;
      var sub = r.querySelector('[data-sub]'); if(sub) sub.textContent = fmt(q*price);
      units += q; total += q*price;
    });
    var u = root.querySelector('[data-units]'); if(u) u.textContent = units;
    var t = root.querySelector('[data-total]'); if(t) t.textContent = fmt(total);
    if(isMobile()){
      // Quick-add: habilitado si la variante elegida está disponible.
      var v = qaCurrent();
      addBtn.disabled = !(v && v.available);
    } else {
      addBtn.disabled = units === 0;
    }
  }

  function doAdd(items, onReset){
    if(!items.length) return;
    addBtn.disabled = true; addBtn.classList.add('is-loading');
    fetch('/cart/add.js', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({items: items})
    }).then(function(r){ if(!r.ok) return r.json().then(function(e){ throw e; }); return r.json(); })
      .then(function(){ return fetch('/cart.js').then(function(r){return r.json();}); })
      .then(function(cart){
        if(onReset) onReset();
        recalc();
        document.body.classList.add('cart-sidebar-show');
        if(window.halo && typeof window.halo.updateSidebarCart==='function'){ window.halo.updateSidebarCart(cart); }
        document.querySelectorAll('[data-cart-count]').forEach(function(el){ el.textContent = cart.item_count; });
      })
      .catch(function(e){ alert((e && e.description) || 'No se pudo añadir al carrito'); })
      .then(function(){ addBtn.classList.remove('is-loading'); recalc(); });
  }

  root.addEventListener('input', function(e){
    if(e.target.classList.contains('b2b-qty')) recalc();
    if(e.target === qaQty) recalc();
  });
  if(qaVariant && qaVariant.tagName === 'SELECT'){ qaVariant.addEventListener('change', recalc); }

  addBtn.addEventListener('click', function(){
    if(isMobile()){
      var v = qaCurrent();
      if(!v || !v.available) return;
      var q = Math.max(1, parseInt(qaQty && qaQty.value)||1);
      doAdd([{ id: v.id, quantity: q }], function(){ if(qaQty) qaQty.value = 1; });
    } else {
      var items = [];
      rows.forEach(function(r){
        var inp = r.querySelector('.b2b-qty');
        var q = inp ? Math.max(0, parseInt(inp.value)||0) : 0;
        if(q>0) items.push({ id: parseInt(r.getAttribute('data-variant-id')), quantity: q });
      });
      doAdd(items, function(){ rows.forEach(function(r){ var i=r.querySelector('.b2b-qty'); if(i) i.value=defQty; }); });
    }
  });

  // La barra se fija al viewport en móvil (visible durante todo el scroll).
  // Se reubica al <body> para que position:fixed no dependa de ancestros.
  var anchor = document.createComment('b2b-bar');
  function placeBar(){
    if(!bar) return;
    if(isMobile()){
      if(bar.parentNode !== document.body){
        bar.parentNode.insertBefore(anchor, bar);
        document.body.appendChild(bar);
        bar.classList.add('b2b-matrix__bar--fixed');
        document.body.classList.add('has-b2b-fixed-bar');
      }
    } else if(anchor.parentNode){
      anchor.parentNode.insertBefore(bar, anchor);
      anchor.parentNode.removeChild(anchor);
      bar.classList.remove('b2b-matrix__bar--fixed');
      document.body.classList.remove('has-b2b-fixed-bar');
    }
    recalc();
  }
  placeBar();
  if(mq.addEventListener){ mq.addEventListener('change', placeBar); } else { window.addEventListener('resize', placeBar); }
  recalc();
})();
</script>
