{%- comment -%} Pistas de red para acelerar USF: conexión temprana al servicio
    de Hotyon y descarga en paralelo del runtime/estilos (antes iban en serie
    después de usf-boot.js). {%- endcomment -%}
<link rel="preconnect" href="https://svc-8-usf.hotyon.com" crossorigin>
<link rel="dns-prefetch" href="https://svc-8-usf.hotyon.com">
<link rel="preconnect" href="https://svc-8-analytics-usf.hotyon.com" crossorigin>
<link rel="preload" as="style" href="{{ 'usf.css' | asset_url }}">
<link rel="preload" as="script" href="{{ 'usf.js' | asset_url }}">
<script data-usf-default-search-sort>
(function () {
    var locationObject = window.location;
    var path = locationObject.pathname.replace(/\/+$/, '');

    if (path !== '/search') return;

    var params = new URLSearchParams(locationObject.search);
    var query = params.get('q');

    if (!query || !query.trim() || params.has('usf_sort')) return;

    params.set('usf_sort', 'bestselling');
    window.history.replaceState(
        window.history.state,
        '',
        locationObject.pathname + '?' + params.toString() + locationObject.hash
    );
})();
</script>
<script>window._usfTheme={
    id:171419173171,
    name:"Ella",
    version:"6.6.1",
    vendor:"Halothemes",
    applied:1,
    assetUrl:"{{ 'usf-boot.js' | asset_url }}"
};
window._usfCustomerTags = {{ customer.tags | json }};
window._usfCollectionId = {{ collection.id | json }};
window._usfCollectionDefaultSort = {{ collection.default_sort_by | json }};
window._usfLocale = {{ request.locale.iso_code | json | downcase }};
window._usfRootUrl = {{ routes.root_url | json }};
window.usf = {
  settings: {{ shop.metafields.usf.settings }}
}
</script>
<script src="{{ 'usf-boot.js' | asset_url }}" async></script>
