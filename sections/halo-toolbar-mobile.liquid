{%- if section.settings.display_section -%}
{{ 'component-toolbar-mobile.css' | asset_url | stylesheet_tag }}
<div class="halo-sticky-toolbar-mobile">
    <div class="bottom-bar">
        <ul class="bottom-bar--list">
            {%- liquid 
                assign font_size = section.settings.font_size | append: 'px'
                assign font_weight = section.settings.font_weight
                assign icon_size = section.settings.icon_size | append: 'px'
            -%}

            {% if routes.account_login_url contains '/account/login' %}
                {% assign is_contained = true %}
            {% else %}
                {% assign is_contained = false %}
            {% endif %}

            {%- for block in section.blocks -%}
                {%- liquid
                    assign icon = block.settings.icon
                    assign text = block.settings.text
                    assign action_icon = block.settings.action_to
                    if block.type == 'link'
                        assign link = block.settings.link
                    else
                        assign link = blank
                    endif
                -%}
                {%- if icon != blank or text != blank -%}

                    <li class="list-item{% if action_icon == 'account' %}{% unless shop.customer_accounts_enabled %} customer_accounts_disable{% endunless %}{% endif %}" style="--font-size: {{ font_size }}; --font-weight: {{ font_weight }}; --icon-size: {{ icon_size }}">
                        <a {% unless is_contained %}href="{{ routes.account_login_url }}"{% endunless %}{% if link == blank %} role="link" aria-disabled="true"{% else %} href="{{ link }}"{% endif %} {% if block.type == 'content' %}data-bar-{{block.type}}{% elsif block.type == 'action' %}{% if action_icon == 'cart' %}{% if settings.show_quick_cart %}data-cart-sidebar{% else %}href="{{ routes.cart_url }}" class="list-item-cart"{% endif %}{% elsif action_icon == 'search' %}data-search-mobile{% elsif action_icon == 'account' %}{% if is_contained %}data-open-auth-sidebar{% endif %}{% endif %}{% endif %}><span class="icon">{{icon}}</span> <span class="text">{{text}}</span>
                            {%- if action_icon == 'cart' -%}
                                <div class="cart-count-bubble" style="--color-bubble: {{ section.settings.bg_color }}; --bg-bubble: {{ section.settings.color_icon }}">
                                    {%- if cart.item_count < 100 -%}
                                        <span class="text" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
                                    {%- endif -%}
                                    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                                </div>
                            {%- endif -%}
                        </a>
                        {%- if block.type == 'content' -%}
                            <div class="block-content bottom-bar--content" id="{{ block.id }}">
                                <button type="button" class="bottom-bar--close halo-sidebar-close clearfix" data-close-content-sidebar aria-label="{{ 'general.common.close' | t }}">{% render 'icon-close' %}{{ 'general.common.close' | t }}</button>
                                <div class="rte">{{ block.settings.content }}</div>
                            </div>
                        {% endif %}
                    </li>


                {%- endif -%}
            {%- endfor -%}

            {%- comment -%} WhatsApp como ítem de la barra (reemplaza el widget flotante en mobile) {%- endcomment -%}
            {%- if section.settings.show_whatsapp and section.settings.whatsapp_link != blank -%}
                <li class="list-item list-item--whatsapp" style="--font-size: {{ font_size }}; --font-weight: {{ font_weight }}; --icon-size: {{ icon_size }}">
                    <a href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                        <span class="icon"><svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg"><path fill="#fff" d="M15,0C6.7,0,0,6.7,0,15s.7,5.3,2,7.5l-2,7.5,7.8-1.8c2.1,1.2,4.6,1.8,7.2,1.8,8.3,0,15-6.7,15-15S23.3,0,15,0ZM15,27.3c-2.5,0-4.8-.7-6.8-2l-4.6,1.2,1.3-4.4c-1.4-2-2.2-4.4-2.2-7,0-6.8,5.5-12.3,12.3-12.3s12.3,5.5,12.3,12.3-5.5,12.3-12.3,12.3Z"/><path fill="#fff" d="M18.5,17l3.6,1.7c.2,0,.3.2.3.4,0,.5-.2,1.4-1.1,2.3-2.4,2.4-6.8-.3-6.9-.4-1.1-.6-2.1-1.3-3-2.3-1-1-1.7-2-2.3-3-.1-.2-2.8-4.5-.4-6.9.9-.9,1.8-1,2.3-1.1.2,0,.4,0,.4.3l1.7,3.6c0,.2,0,.4,0,.5l-1.3,1.3c-.3.3-.4.7-.2,1,.5.8,1.1,1.6,1.8,2.4.7.7,1.5,1.4,2.4,1.8.3.2.8.1,1-.2l1.3-1.3c.1-.1.3-.2.5,0Z"/></svg></span>
                        <span class="text visually-hidden">{{ section.settings.whatsapp_text | default: 'WhatsApp' }}</span>
                    </a>
                </li>
            {%- endif -%}
        </ul>
    </div>
</div>
<style>
    {%- liquid
        assign color_icon = section.settings.color_icon
        assign bg_color = section.settings.bg_color
        assign bg_color_gradient = section.settings.bg_color_gradient
        assign border_color = section.settings.border_color
    -%}
    .halo-sticky-toolbar-mobile {background: {% if bg_color_gradient != blank %}{{bg_color_gradient}}{% else %}{{bg_color}}{% endif %};border: 1px solid {{border_color}}}
    .halo-sticky-toolbar-mobile span {color: {{color_icon}}}
    .halo-sticky-toolbar-mobile span.icon svg {fill: {{color_icon}}}
</style>
<script>
    const buttons = document.querySelectorAll('[data-bar-content]');
    if (buttons.length) {
        buttons.forEach((button) => {
            button.addEventListener('click', (event) => {
                event.preventDefault();
                if (event.target.nextSibling.classList.contains('show')) {
                    event.target.nextSibling.classList.remove('show');
                    document.querySelector('body').classList.remove('show-sidebar-content');
                } else {
                    event.target.nextSibling.classList.add('show');
                    document.querySelector('body').classList.add('show-sidebar-content');
                }
            })
        });
        document.querySelectorAll('[data-close-content-sidebar]').forEach((button) => {
            button.addEventListener('click', (event) => {
                event.target.closest('.bottom-bar--content').classList.remove('show');
            });
        })
    }
    $('body').addClass('sticky-toolbar-mobile');
</script>
{%- endif -%}

{% schema %}
{
