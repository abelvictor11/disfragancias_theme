        "default": true
    },
    {
        "type": "text",
        "id": "whatsapp_link",
        "label": "Enlace de WhatsApp",
        "default": "https://wa.me/message/OEMXSRLFZHQXD1"
    },
    {
        "type": "text",
        "id": "whatsapp_text",
