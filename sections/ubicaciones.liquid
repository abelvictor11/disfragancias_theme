{%- comment -%}
  Landing de Ubicaciones (Disfragancias). Sección rica visualmente, editable
  desde el personalizador: hero, intro, tarjetas de sede (bloques) con foto,
  dirección, horarios, teléfono/WhatsApp y "Cómo llegar", franja de beneficios
  y CTA. Estilos embebidos y scopeados por section.id (no depende de assets).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign container = s.container | default: '1170'
  assign accent = s.accent_color | default: '#ba7a2d'
  assign accent_soft = s.accent_soft | default: '#FEBC6E'
  assign dark = '#232323'
-%}

<style>
  #ubic-{{ uid }} { --ubi-accent: {{ accent }}; --ubi-soft: {{ accent_soft }}; --ubi-dark: {{ dark }}; --ubi-beige: rgba(230,222,211,.28); --ubi-line: rgba(35,35,35,.10); }
  #ubic-{{ uid }} .ubi-heading { font-family: var(--font-heading-family), 'Cinzel', serif; font-weight: 400; letter-spacing: .01em; color: var(--ubi-dark); }
  #ubic-{{ uid }} .ubi-kicker { display:inline-flex; align-items:center; gap:8px; font-size:12px; letter-spacing:.22em; text-transform:uppercase; color: var(--ubi-accent); font-weight:600; }
  #ubic-{{ uid }} .ubi-kicker::before { content:""; width:28px; height:1px; background: var(--ubi-accent); display:inline-block; }

  /* Hero */
  #ubic-{{ uid }} .ubi-hero { position:relative; border-radius:16px; overflow:hidden; min-height:{{ s.hero_height | default: 460 }}px; display:flex; align-items:flex-end; }
  #ubic-{{ uid }} .ubi-hero__bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #ubic-{{ uid }} .ubi-hero::after { content:""; position:absolute; inset:0; background: linear-gradient(180deg, rgba(20,18,16,.15) 0%, rgba(20,18,16,.72) 100%); }
  #ubic-{{ uid }} .ubi-hero__inner { position:relative; z-index:2; padding: clamp(22px,4vw,54px); max-width: 760px; }
  #ubic-{{ uid }} .ubi-hero .ubi-kicker, #ubic-{{ uid }} .ubi-hero .ubi-heading, #ubic-{{ uid }} .ubi-hero p { color:#fff; }
  #ubic-{{ uid }} .ubi-hero .ubi-kicker::before { background:#fff; }
  #ubic-{{ uid }} .ubi-hero__title { font-size: clamp(30px,5vw,56px); line-height:1.05; margin:14px 0 10px; color:#fff; }
  #ubic-{{ uid }} .ubi-hero__sub { font-size: clamp(14px,1.6vw,18px); color: rgba(255,255,255,.9); max-width:560px; }
  #ubic-{{ uid }} .ubi-hero__noimg { position:absolute; inset:0; background: var(--ubi-dark); }

  /* Intro */
  #ubic-{{ uid }} .ubi-intro { text-align:center; max-width:720px; margin: 44px auto 8px; }
  #ubic-{{ uid }} .ubi-intro h2 { font-size: clamp(24px,3vw,36px); margin: 10px 0 12px; }
  #ubic-{{ uid }} .ubi-intro p { color:#555; font-size:16px; line-height:1.7; }

  /* Grid de sedes */
  #ubic-{{ uid }} .ubi-grid { display:grid; grid-template-columns: repeat({{ s.columns | default: 2 }}, minmax(0,1fr)); gap: 26px; margin-top: 34px; }
  #ubic-{{ uid }} .ubi-card { background:#fff; border:1px solid var(--ubi-line); border-radius:14px; overflow:hidden; display:flex; flex-direction:column; transition: box-shadow .25s ease, transform .25s ease; }
  #ubic-{{ uid }} .ubi-card:hover { box-shadow: 0 18px 40px rgba(20,18,16,.12); transform: translateY(-3px); }
  #ubic-{{ uid }} .ubi-card__media { position:relative; aspect-ratio: 16/10; background: var(--ubi-beige); overflow:hidden; }
  #ubic-{{ uid }} .ubi-card__media img { width:100%; height:100%; object-fit:cover; transition: transform .5s ease; }
  #ubic-{{ uid }} .ubi-card:hover .ubi-card__media img { transform: scale(1.05); }
  #ubic-{{ uid }} .ubi-card__badge { position:absolute; top:12px; left:12px; z-index:2; background: rgba(255,255,255,.92); color:var(--ubi-dark); font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-weight:600; padding:6px 12px; border-radius:100px; }
  #ubic-{{ uid }} .ubi-card__body { padding: 20px 22px 22px; display:flex; flex-direction:column; gap:12px; flex:1; }
  #ubic-{{ uid }} .ubi-card__name { font-size:22px; margin:0; }
  #ubic-{{ uid }} .ubi-row { display:flex; gap:10px; align-items:flex-start; color:#444; font-size:14px; line-height:1.5; }
  #ubic-{{ uid }} .ubi-row svg { flex:0 0 18px; width:18px; height:18px; color: var(--ubi-accent); margin-top:1px; }
  #ubic-{{ uid }} .ubi-hours { margin:0; padding:0; list-style:none; color:#444; font-size:14px; }
  #ubic-{{ uid }} .ubi-hours li { display:flex; justify-content:space-between; gap:12px; padding:4px 0; border-bottom:1px dashed var(--ubi-line); }
  #ubic-{{ uid }} .ubi-hours li:last-child { border-bottom:0; }
  #ubic-{{ uid }} .ubi-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:auto; padding-top:6px; }
  #ubic-{{ uid }} .ubi-btn { display:inline-flex; align-items:center; gap:8px; padding:11px 18px; border-radius:9px; font-size:13px; font-weight:600; text-decoration:none; cursor:pointer; transition: all .2s ease; border:1px solid transparent; }
  #ubic-{{ uid }} .ubi-btn--dark { background: var(--ubi-dark); color:#fff; }
  #ubic-{{ uid }} .ubi-btn--dark:hover { background:#000; }
  #ubic-{{ uid }} .ubi-btn--ghost { background:transparent; color:var(--ubi-dark); border-color: var(--ubi-line); }
  #ubic-{{ uid }} .ubi-btn--ghost:hover { border-color: var(--ubi-dark); }
  #ubic-{{ uid }} .ubi-btn--wa { background:#25D366; color:#fff; }
  #ubic-{{ uid }} .ubi-btn--wa:hover { filter:brightness(.95); }

  /* Franja de beneficios */
  #ubic-{{ uid }} .ubi-perks { display:grid; grid-template-columns: repeat(4,1fr); gap:16px; margin-top:48px; }
  #ubic-{{ uid }} .ubi-perk { background: var(--ubi-beige); border-radius:12px; padding:20px; text-align:center; }
  #ubic-{{ uid }} .ubi-perk svg { width:26px; height:26px; color:var(--ubi-accent); }
  #ubic-{{ uid }} .ubi-perk h4 { font-size:14px; margin:10px 0 4px; color:var(--ubi-dark); }
  #ubic-{{ uid }} .ubi-perk p { font-size:12.5px; color:#666; margin:0; }

  /* CTA */
  #ubic-{{ uid }} .ubi-cta { margin-top:52px; background: var(--ubi-dark); border-radius:16px; padding: clamp(28px,4vw,50px); text-align:center; color:#fff; position:relative; overflow:hidden; }
  #ubic-{{ uid }} .ubi-cta::before { content:""; position:absolute; inset:0; background: radial-gradient(circle at 20% 0%, rgba(254,188,110,.18), transparent 55%); }
  #ubic-{{ uid }} .ubi-cta > * { position:relative; z-index:2; }
  #ubic-{{ uid }} .ubi-cta h2 { color:#fff; font-size: clamp(24px,3vw,38px); margin:0 0 8px; }
  #ubic-{{ uid }} .ubi-cta p { color: rgba(255,255,255,.82); margin:0 0 22px; }
  #ubic-{{ uid }} .ubi-cta .ubi-btn--wa { padding:14px 26px; font-size:15px; }

  @media (max-width: 990px) {
    #ubic-{{ uid }} .ubi-grid { grid-template-columns: 1fr; }
    #ubic-{{ uid }} .ubi-perks { grid-template-columns: repeat(2,1fr); }
  }
</style>

<section id="ubic-{{ uid }}" class="ubicaciones-section" style="padding: {{ s.padding_top | default: 40 }}px 0 {{ s.padding_bottom | default: 60 }}px;">
  <div class="{% if container == '1770' %}container-1770{% elsif container == 'fullwidth' %}container-full{% else %}container-1170{% endif %}">

    {%- comment -%} HERO {%- endcomment -%}
    <div class="ubi-hero">
      {%- if s.hero_image != blank -%}
        <img class="ubi-hero__bg" src="{{ s.hero_image | image_url: width: 2000 }}" alt="{{ s.hero_title | escape }}" loading="eager" width="2000" height="900">
      {%- else -%}
        <span class="ubi-hero__noimg"></span>
      {%- endif -%}
      <div class="ubi-hero__inner">
        {%- if s.kicker != blank -%}<span class="ubi-kicker">{{ s.kicker }}</span>{%- endif -%}
        <h1 class="ubi-heading ubi-hero__title">{{ s.hero_title | default: 'Nuestras tiendas' }}</h1>
        {%- if s.hero_subtitle != blank -%}<p class="ubi-hero__sub">{{ s.hero_subtitle }}</p>{%- endif -%}
      </div>
    </div>

    {%- comment -%} INTRO {%- endcomment -%}
    {%- if s.intro_title != blank or s.intro_text != blank -%}
      <div class="ubi-intro">
        {%- if s.intro_kicker != blank -%}<span class="ubi-kicker">{{ s.intro_kicker }}</span>{%- endif -%}
        {%- if s.intro_title != blank -%}<h2 class="ubi-heading">{{ s.intro_title }}</h2>{%- endif -%}
        {%- if s.intro_text != blank -%}<p>{{ s.intro_text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} SEDES {%- endcomment -%}
    <div class="ubi-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'location' -%}
          {%- assign b = block.settings -%}
          <article class="ubi-card" {{ block.shopify_attributes }}>
            <div class="ubi-card__media">
              {%- if b.image != blank -%}
                <img src="{{ b.image | image_url: width: 900 }}" alt="{{ b.name | escape }}" loading="lazy" width="900" height="560">
              {%- endif -%}
              {%- if b.badge != blank -%}<span class="ubi-card__badge">{{ b.badge }}</span>{%- endif -%}
            </div>
            <div class="ubi-card__body">
              <h3 class="ubi-heading ubi-card__name">{{ b.name | default: 'Sede' }}</h3>

              {%- if b.address != blank -%}
                <div class="ubi-row">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>{{ b.address }}</span>
                </div>
              {%- endif -%}

              {%- if b.phone != blank -%}
                <div class="ubi-row">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"/></svg>
                  <a href="tel:{{ b.phone | remove: ' ' }}" style="color:inherit;text-decoration:none;">{{ b.phone }}</a>
                </div>
              {%- endif -%}

              {%- if b.hours != blank -%}
                <div class="ubi-row" style="align-items:flex-start;">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                  <div style="flex:1;">{{ b.hours }}</div>
                </div>
              {%- endif -%}

              <div class="ubi-actions">
                {%- if b.maps_url != blank -%}
                  <a class="ubi-btn ubi-btn--dark" href="{{ b.maps_url }}" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                    Cómo llegar
                  </a>
                {%- endif -%}
                {%- if b.whatsapp != blank -%}
                  <a class="ubi-btn ubi-btn--wa" href="{{ b.whatsapp }}" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.13L2 22l4.98-1.3A9.9 9.9 0 1 0 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.94 1.35-.5.05-1.13.07-1.83-.11a10.7 10.7 0 0 1-1.66-.62 8.6 8.6 0 0 1-3.3-2.92c-.23-.31-.9-1.2-.9-2.28s.57-1.62.78-1.84c.2-.22.44-.28.59-.28l.42.01c.14 0 .32-.05.5.38.2.48.66 1.66.72 1.78.06.12.1.26.02.42-.08.16-.12.26-.24.4l-.36.42c-.12.12-.24.25-.1.49.14.24.62 1.02 1.33 1.65.9.8 1.67 1.05 1.9 1.17.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.18 1.26Z"/></svg>
                    Escríbenos
                  </a>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} BENEFICIOS {%- endcomment -%}
    {%- assign perk_blocks = section.blocks | where: 'type', 'perk' -%}
    {%- if perk_blocks.size > 0 -%}
      <div class="ubi-perks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            <div class="ubi-perk" {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <h4 class="ubi-heading" style="font-family:var(--font-heading-family),'Cinzel',serif;">{{ block.settings.title }}</h4>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} CTA {%- endcomment -%}
    {%- if s.cta_title != blank -%}
      <div class="ubi-cta">
        <h2 class="ubi-heading">{{ s.cta_title }}</h2>
        {%- if s.cta_text != blank -%}<p>{{ s.cta_text }}</p>{%- endif -%}
        {%- if s.cta_button_label != blank and s.cta_button_url != blank -%}
          <a class="ubi-btn ubi-btn--wa" href="{{ s.cta_button_url }}" target="_blank" rel="noopener">{{ s.cta_button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Ubicaciones",
  "tag": "section",
  "class": "section-ubicaciones",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Imagen de fondo del hero" },
    { "type": "range", "id": "hero_height", "label": "Alto del hero", "min": 320, "max": 640, "step": 20, "unit": "px", "default": 460 },
    { "type": "text", "id": "kicker", "label": "Texto pequeño (kicker)", "default": "Perfumería original desde 1980" },
    { "type": "text", "id": "hero_title", "label": "Título", "default": "Visítanos en nuestras tiendas" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Subtítulo", "default": "Vive la experiencia Disfragancias en persona: prueba, huele y déjate asesorar por nuestro equipo." },

    { "type": "header", "content": "Introducción" },
    { "type": "text", "id": "intro_kicker", "label": "Kicker intro", "default": "Encuéntranos" },
    { "type": "text", "id": "intro_title", "label": "Título intro", "default": "Nuestras ubicaciones" },
    { "type": "textarea", "id": "intro_text", "label": "Texto intro", "default": "Te esperamos con la selección más amplia de fragancias originales, decants y asesoría personalizada." },

    { "type": "header", "content": "Diseño" },
    {
      "type": "select", "id": "container", "label": "Ancho", "default": "1170",
      "options": [
        { "value": "1170", "label": "1170" },
        { "value": "1770", "label": "1770" },
        { "value": "fullwidth", "label": "Ancho completo" }
      ]
    },
    {
      "type": "select", "id": "columns", "label": "Columnas (escritorio)", "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "color", "id": "accent_color", "label": "Color de acento", "default": "#ba7a2d" },
    { "type": "color", "id": "accent_soft", "label": "Acento suave", "default": "#FEBC6E" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },

    { "type": "header", "content": "Llamado a la acción (CTA)" },
    { "type": "text", "id": "cta_title", "label": "Título CTA", "default": "¿Tienes dudas antes de visitarnos?" },
    { "type": "textarea", "id": "cta_text", "label": "Texto CTA", "default": "Escríbenos por WhatsApp y con gusto te ayudamos." },
    { "type": "text", "id": "cta_button_label", "label": "Texto del botón", "default": "Escríbenos por WhatsApp" },
    { "type": "url", "id": "cta_button_url", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Sede",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto de la sede" },
        { "type": "text", "id": "badge", "label": "Etiqueta (opcional)", "info": "Ej: Tienda principal", "default": "Tienda física" },
        { "type": "text", "id": "name", "label": "Nombre / ciudad", "default": "Medellín" },
        { "type": "textarea", "id": "address", "label": "Dirección", "default": "Cra. 00 # 00-00, Medellín, Antioquia" },
        { "type": "text", "id": "phone", "label": "Teléfono", "default": "+57 300 000 0000" },
        { "type": "richtext", "id": "hours", "label": "Horarios", "default": "<p>Lun–Sáb: 9:00 a.m. – 7:00 p.m.<br/>Dom y festivos: 10:00 a.m. – 5:00 p.m.</p>" },
        { "type": "url", "id": "maps_url", "label": "Enlace 'Cómo llegar' (Google Maps)" },
        { "type": "url", "id": "whatsapp", "label": "Enlace WhatsApp" }
      ]
    },
    {
      "type": "perk",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Producto 100% original" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Sellado y garantizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ubicaciones",
      "blocks": [
        { "type": "location", "settings": { "name": "Medellín — Tienda principal", "badge": "Desde 1980" } },
        { "type": "perk", "settings": { "title": "100% originales", "text": "Sellados y garantizados" } },
        { "type": "perk", "settings": { "title": "Asesoría experta", "text": "Te ayudamos a elegir" } },
        { "type": "perk", "settings": { "title": "Prueba en tienda", "text": "Huele antes de comprar" } },
        { "type": "perk", "settings": { "title": "Decants disponibles", "text": "Llévalo en tu tamaño" } }
      ]
    }
  ]
}
{% endschema %}
