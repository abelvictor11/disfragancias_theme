{%- comment -%}
  Black Friday · Hero con cuenta regresiva.
  Sección independiente, editable y ocultable. Estilos en assets/bf-home.css.
{%- endcomment -%}

{{ 'bf-home.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  {%- liquid
    assign has_bottle = false
    if section.settings.bottle_image != blank
      assign has_bottle = true
    endif
  -%}

  <section
    class="bf-hero{% unless has_bottle %} bf-hero--no-bottle{% endunless %}"
    data-bf-countdown
    data-bf-target="{{ section.settings.countdown_target }}">

    {%- if has_bottle -%}
      <img
        class="bf-hero__bottle"
        src="{{ section.settings.bottle_image | image_url: width: 400 }}"
        alt=""
        role="presentation"
        width="{{ section.settings.bottle_image.width }}"
        height="{{ section.settings.bottle_image.height }}"
        loading="lazy">
    {%- endif -%}

    <div class="bf-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bf-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.highlight != blank or section.settings.heading_end != blank -%}
        <h2 class="bf-hero__title">
          {{- section.settings.heading | escape }}
          {%- if section.settings.highlight != blank %} <em>{{ section.settings.highlight | escape }}</em>{% endif -%}
          {%- if section.settings.heading_end != blank %}<br>{{ section.settings.heading_end | escape }}{% endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="bf-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_countdown -%}
        <ul class="bf-countdown" aria-label="Tiempo restante de la oferta">
          <li class="bf-flip">
            <span class="bf-flip__label">{{ section.settings.label_days | escape }}</span>
            <span class="bf-flip__card"><b data-bf-days>00</b></span>
          </li>
          <li class="bf-flip">
            <span class="bf-flip__label">{{ section.settings.label_hours | escape }}</span>
            <span class="bf-flip__card"><b data-bf-hours>00</b></span>
          </li>
          <li class="bf-flip">
            <span class="bf-flip__label">{{ section.settings.label_minutes | escape }}</span>
            <span class="bf-flip__card"><b data-bf-minutes>00</b></span>
          </li>
          <li class="bf-flip">
            <span class="bf-flip__label">{{ section.settings.label_seconds | escape }}</span>
            <span class="bf-flip__card"><b data-bf-seconds>00</b></span>
          </li>
        </ul>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <a class="button button--primary bf-hero__cta" href="{{ section.settings.cta_link | default: '#' }}">
          {{- section.settings.cta_text | escape -}}
        </a>
      {%- endif -%}
    </div>
  </section>

  <script>
    (function () {
      var root = document.querySelector('[data-bf-countdown][data-bf-target="{{ section.settings.countdown_target }}"]')
        || document.currentScript.previousElementSibling;
      if (!root) return;
      var target = new Date(root.getAttribute('data-bf-target')).getTime();
      if (isNaN(target)) return;

      var elDays = root.querySelector('[data-bf-days]');
      var elHours = root.querySelector('[data-bf-hours]');
      var elMinutes = root.querySelector('[data-bf-minutes]');
      var elSeconds = root.querySelector('[data-bf-seconds]');
      if (!elDays) return;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function tick() {
        var t = Math.max(0, (target - Date.now()) / 1000);
        elDays.textContent = pad(Math.floor(t / 86400));
        elHours.textContent = pad(Math.floor((t % 86400) / 3600));
        elMinutes.textContent = pad(Math.floor((t % 3600) / 60));
        elSeconds.textContent = pad(Math.floor(t % 60));
        if (t <= 0 && window.__bfTimer) { clearInterval(window.__bfTimer); }
      }

      tick();
      window.__bfTimer = setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "BF · Hero + countdown",
  "tag": "section",
  "class": "bf-section bf-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Mostrar sección",
      "default": true
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Black Friday 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (inicio)",
      "default": "Hasta"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Destacado (dorado)",
      "info": "El descuento es el protagonista del hero.",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Título (fin)",
      "default": "OFF"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Perfumes originales de diseñador, árabes y nicho."
    },
    {
      "type": "image_picker",
      "id": "bottle_image",
      "label": "Imagen decorativa (opcional)",
      "info": "Botella / producto a la derecha. Si se deja vacío, el texto ocupa todo el ancho."
    },
    {
      "type": "header",
      "content": "Cuenta regresiva"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Mostrar cuenta regresiva",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_target",
      "label": "Fecha y hora objetivo",
      "info": "Formato ISO con zona horaria. Bogotá = -05:00. Ej: 2026-11-27T00:00:00-05:00",
      "default": "2026-11-27T00:00:00-05:00"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Etiqueta días",
      "default": "días"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Etiqueta horas",
      "default": "horas"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Etiqueta minutos",
      "default": "min"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Etiqueta segundos",
      "default": "seg"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del botón",
      "default": "Ver todas las ofertas"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "BF · Hero + countdown"
    }
  ]
}
{% endschema %}
