{%- comment -%}
  Lista de beneficios / confianza para el PDP (Disfragancias).
  Filas editables (bloques): cada una con un ícono (imagen o carácter/emoji
  dentro de un "chip" de color) + una línea principal en negrita + un subtexto.
  Estilos embebidos y scopeados por section.id; mantiene los tokens de marca.
  Se puede agregar en cualquier plantilla (incluido el PDP) desde el editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign container = s.container | default: '1170'
  assign accent = s.accent_color | default: '#ba7a2d'
  assign dark = '#232323'
-%}

{%- style -%}
  #pdp-perks-{{ uid }} {
    --pp-accent: {{ accent }};
    --pp-card-bg: {{ s.card_bg }};
    --pp-border: {{ s.border_color }};
    --pp-lead: {{ s.lead_color }};
    --pp-sub: {{ s.sub_color }};
    --pp-radius: {{ s.card_radius }}px;
  }
  #pdp-perks-{{ uid }} .pp-wrap {
    max-width: {{ container }}px;
    margin: 0 auto;
    padding: 0 15px;
  }
  #pdp-perks-{{ uid }} .pp-card {
    background: var(--pp-card-bg);
    border: 1px solid var(--pp-border);
    border-radius: var(--pp-radius);
    overflow: hidden;
  }
  #pdp-perks-{{ uid }} .pp-title {
    font-family: var(--font-heading-family), 'Cinzel', serif;
    font-weight: 400;
    color: var(--pp-lead);
    font-size: {{ s.title_size }}px;
    margin: 0 0 14px;
    letter-spacing: .01em;
  }
  #pdp-perks-{{ uid }} .pp-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: {{ s.row_padding }}px {{ s.row_padding | plus: 2 }}px;
  }
  {%- if s.dividers -%}
  #pdp-perks-{{ uid }} .pp-row + .pp-row { border-top: 1px solid var(--pp-border); }
  {%- endif -%}
  #pdp-perks-{{ uid }} .pp-chip {
    flex: 0 0 auto;
    width: {{ s.chip_size }}px;
    height: {{ s.chip_size }}px;
    border-radius: {{ s.chip_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: {{ s.chip_size | times: 0.5 | round }}px;
    font-weight: 700;
    line-height: 1;
  }
  #pdp-perks-{{ uid }} .pp-chip img {
    width: 62%;
    height: 62%;
    object-fit: contain;
    display: block;
  }
  #pdp-perks-{{ uid }} .pp-text { min-width: 0; }
  #pdp-perks-{{ uid }} .pp-lead {
    margin: 0;
    color: var(--pp-sub);
    font-size: {{ s.lead_size }}px;
    line-height: 1.4;
  }
  #pdp-perks-{{ uid }} .pp-lead strong,
  #pdp-perks-{{ uid }} .pp-lead b { color: var(--pp-lead); font-weight: 700; }
  #pdp-perks-{{ uid }} .pp-sub {
    margin: 4px 0 0;
    color: var(--pp-sub);
    font-size: {{ s.sub_size }}px;
    line-height: 1.45;
    opacity: .85;
  }
  @media (max-width: 767px) {
    #pdp-perks-{{ uid }} .pp-row { padding: {{ s.row_padding | minus: 2 }}px {{ s.row_padding }}px; gap: 12px; }
    #pdp-perks-{{ uid }} .pp-chip { width: {{ s.chip_size | minus: 6 }}px; height: {{ s.chip_size | minus: 6 }}px; }
  }
{%- endstyle -%}

<div id="pdp-perks-{{ uid }}"
     style="margin-top:{{ s.mg_top }}px;margin-bottom:{{ s.mg_bottom }}px;">
  <div class="pp-wrap">
    {%- if s.heading != blank -%}
      <h3 class="pp-title">{{ s.heading }}</h3>
    {%- endif -%}
    <div class="pp-card">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign chip_bg = bs.chip_bg | default: accent
          assign chip_fg = bs.chip_fg | default: '#ffffff'
        -%}
        <div class="pp-row" {{ block.shopify_attributes }}>
          <span class="pp-chip" style="background:{{ chip_bg }};color:{{ chip_fg }};">
            {%- if bs.icon_type == 'image' and bs.image != blank -%}
              {{ bs.image | image_url: width: 120 | image_tag: alt: bs.image.alt | escape, loading: 'lazy' }}
            {%- else -%}
              {{ bs.icon_char }}
            {%- endif -%}
          </span>
          <div class="pp-text">
            {%- if bs.lead != blank -%}<p class="pp-lead">{{ bs.lead }}</p>{%- endif -%}
            {%- if bs.sub != blank -%}<p class="pp-sub">{{ bs.sub }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP · Beneficios",
  "tag": "section",
  "class": "section-pdp-perks",
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "heading", "label": "Título (opcional)" },
    {
      "type": "select", "id": "container", "label": "Ancho del contenedor", "default": "1170",
      "options": [
        { "value": "750", "label": "Angosto (750)" },
        { "value": "1170", "label": "Mediano (1170)" },
        { "value": "1770", "label": "Ancho (1770)" }
      ]
    },
    { "type": "header", "content": "Estilo de la tarjeta" },
    { "type": "color", "id": "card_bg", "label": "Fondo de la tarjeta", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Bordes y divisores", "default": "#e6e6e6" },
    { "type": "checkbox", "id": "dividers", "label": "Mostrar líneas divisoras entre filas", "default": true },
    { "type": "range", "id": "card_radius", "label": "Radio de la tarjeta", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "row_padding", "label": "Espaciado de cada fila", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "header", "content": "Íconos (chips)" },
    { "type": "range", "id": "chip_size", "label": "Tamaño del chip", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "chip_radius", "label": "Radio del chip", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Tipografía" },
    { "type": "color", "id": "lead_color", "label": "Color texto principal (negrita)", "default": "#232323" },
    { "type": "color", "id": "sub_color", "label": "Color texto secundario", "default": "#3c3c3c" },
    { "type": "range", "id": "title_size", "label": "Tamaño del título", "min": 14, "max": 34, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "lead_size", "label": "Tamaño línea principal", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "sub_size", "label": "Tamaño subtexto", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Márgenes de la sección" },
    { "type": "range", "id": "mg_top", "label": "Margen superior", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mg_bottom", "label": "Margen inferior", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "accent_color", "label": "Color de acento (chip por defecto)", "default": "#ba7a2d" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select", "id": "icon_type", "label": "Tipo de ícono", "default": "character",
          "options": [
            { "value": "character", "label": "Carácter / emoji" },
            { "value": "image", "label": "Imagen (SVG/PNG)" }
          ]
        },
        { "type": "text", "id": "icon_char", "label": "Carácter o emoji", "info": "Ej: %  ✓  ◆  ★  ♥", "default": "✓" },
        { "type": "image_picker", "id": "image", "label": "Imagen del ícono" },
        { "type": "color", "id": "chip_bg", "label": "Fondo del chip", "default": "#ba7a2d" },
        { "type": "color", "id": "chip_fg", "label": "Color del ícono", "default": "#ffffff" },
        { "type": "inline_richtext", "id": "lead", "label": "Línea principal", "info": "Usa negrita para resaltar la parte clave.", "default": "<strong>Beneficio destacado</strong> con tu texto aquí." },
        { "type": "inline_richtext", "id": "sub", "label": "Subtexto", "default": "Detalle secundario del beneficio." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PDP · Beneficios",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon_type": "character",
            "icon_char": "%",
            "chip_bg": "#FEBC6E",
            "chip_fg": "#232323",
            "lead": "<strong>5% menos pagando por transferencia</strong> o en cuotas con Addi y Sistecrédito, sin cuota inicial.",
            "sub": "Bancolombia, Davivienda, Nequi, QR, tarjetas, Bold y Wompi."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "character",
            "icon_char": "✓",
            "chip_bg": "#8ecfc6",
            "chip_fg": "#ffffff",
            "lead": "<strong>Más de 500.000 pedidos entregados</strong> en toda Colombia.",
            "sub": "Envío con Interrapidísimo o Coordinadora y guía de rastreo a tu correo."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "character",
            "icon_char": "◆",
            "chip_bg": "#232323",
            "chip_fg": "#ffffff",
            "lead": "<strong>Original garantizado desde 1980</strong> · tiendas en Medellín y Bogotá.",
            "sub": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
