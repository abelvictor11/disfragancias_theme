{%- comment -%}
  Black Friday · Hub de ofertas (dark). Tarjeta "flash" con temporizador opcional
  + celdas (Combos, Liquidación, Testers…). Cada celda es un bloque editable.
  Sección independiente y ocultable. Estilos en assets/bf-home.css.
{%- endcomment -%}

{{ 'bf-home.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  {%- liquid
    assign has_bg = false
    if section.settings.bg_image != blank or section.settings.bg_color != blank
      assign has_bg = true
    endif
    assign bg_url = ''
    if section.settings.bg_image != blank
      assign bg_url = section.settings.bg_image | image_url: width: 2400
    endif
    capture bf_style
      if section.settings.card_radius != blank
        echo '--bf-radius:' | append: section.settings.card_radius | append: 'px;'
      endif
      if section.settings.heading_color != blank
        echo '--bf-head-color:' | append: section.settings.heading_color | append: ';'
      endif
      if section.settings.badge_radius != blank
        echo '--bf-badge-radius:' | append: section.settings.badge_radius | append: 'px;'
      endif
      if section.settings.badge_bg != blank
        echo '--bf-badge-bg:' | append: section.settings.badge_bg | append: ';'
      endif
      if section.settings.badge_color != blank
        echo '--bf-badge-color:' | append: section.settings.badge_color | append: ';'
      endif
      if section.settings.bg_color != blank
        echo 'background-color:' | append: section.settings.bg_color | append: ';'
      endif
      if bg_url != blank
        echo "background-image:url('" | append: bg_url | append: "');"
      endif
    endcapture
  -%}
  <div class="bf-hub-sec{% if has_bg %} bf-hub-sec--has-bg{% endif %}"{% if bf_style != blank %} style="{{ bf_style }}"{% endif %}>
    <div class="bf-hub">
      {%- if section.settings.heading != blank or section.settings.link_text != blank -%}
        <div class="bf-sec-head">
          {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading | escape }}</h3>{%- endif -%}
          {%- if section.settings.link_text != blank -%}
            <a href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_text | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="bf-hub__grid">
        {%- if section.settings.flash_enable -%}
          {%- liquid
            assign flash_tag = 'div'
            if section.settings.flash_link != blank
              assign flash_tag = 'a'
            endif
          -%}
          <{{ flash_tag }} class="bf-hcell bf-hcell--flash"
            {%- if section.settings.flash_link != blank %} href="{{ section.settings.flash_link }}"{% endif -%}>
            <span class="bf-hcell__flashtxt">
              <b>{{ section.settings.flash_title | default: '⚡ Ofertas flash' | escape }}</b>
              {%- if section.settings.flash_subtitle != blank -%}
                <small>{{ section.settings.flash_subtitle | escape }}</small>
              {%- endif -%}
            </span>
            {%- if section.settings.flash_show_timer -%}
              <span class="bf-flashtimer"
                data-bf-flash
                data-cycle-hours="{{ section.settings.flash_cycle_hours | default: 4 }}">--:--:--</span>
            {%- endif -%}
          </{{ flash_tag }}>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign cell_tag = 'div'
            if block.settings.link != blank
              assign cell_tag = 'a'
            endif
          -%}
          <{{ cell_tag }} class="bf-hcell"
            {%- if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif -%}
            {{ block.shopify_attributes }}>
            <b>{{ block.settings.title | escape }}</b>
            {%- if block.settings.subtitle != blank -%}
              <small>{{ block.settings.subtitle | escape }}</small>
            {%- endif -%}
          </{{ cell_tag }}>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.flash_enable and section.settings.flash_show_timer -%}
    <script>
      (function(){
        var el = document.querySelector('#shopify-section-{{ section.id }} [data-bf-flash]');
        if(!el){return;}
        var pad = function(n){ return (n<10?'0':'') + n; };
        var cycle = (parseFloat(el.getAttribute('data-cycle-hours')) || 4) * 3600;
        function tick(){
          var now = Math.floor(Date.now()/1000);
          var left = cycle - (now % cycle);
          el.textContent = pad(Math.floor(left/3600)) + ':' + pad(Math.floor(left%3600/60)) + ':' + pad(left%60);
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "BF · Hub de ofertas",
  "tag": "section",
  "class": "bf-offers-hub-section",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Mostrar sección", "default": true },
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Ofertas Black Friday" },
    { "type": "text", "id": "link_text", "label": "Texto del enlace (opcional)", "default": "Ver todo" },
    { "type": "url", "id": "link_url", "label": "Enlace del encabezado" },
    { "type": "header", "content": "Tarjeta flash (destacada)" },
    { "type": "checkbox", "id": "flash_enable", "label": "Mostrar tarjeta flash", "default": true },
    { "type": "text", "id": "flash_title", "label": "Título", "default": "⚡ Ofertas flash" },
    { "type": "text", "id": "flash_subtitle", "label": "Subtítulo", "default": "Cambian cada pocas horas" },
    { "type": "url", "id": "flash_link", "label": "Enlace (colección Flash)" },
    { "type": "checkbox", "id": "flash_show_timer", "label": "Mostrar temporizador", "default": true },
    { "type": "range", "id": "flash_cycle_hours", "min": 1, "max": 24, "step": 1, "unit": "h", "label": "Ciclo del temporizador", "default": 4, "info": "Cuenta regresiva rotativa que se reinicia cada N horas." },
    { "type": "header", "content": "Diseño" },
    { "type": "range", "id": "card_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Radio de las celdas", "default": 14 },
    { "type": "color", "id": "heading_color", "label": "Color del encabezado" },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección (color)" },
    { "type": "image_picker", "id": "bg_image", "label": "Fondo de la sección (imagen)" },
    { "type": "header", "content": "Badge del temporizador flash" },
    { "type": "range", "id": "badge_radius", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Radio del badge", "default": 8 },
    { "type": "color", "id": "badge_bg", "label": "Fondo del badge" },
    { "type": "color", "id": "badge_color", "label": "Color del texto del badge" }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Celda",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Combos" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo" },
        { "type": "url", "id": "link", "label": "Enlace (colección)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "BF · Hub de ofertas",
      "settings": {
        "heading": "Ofertas Black Friday",
        "link_text": "Ver todo",
        "flash_title": "⚡ Ofertas flash",
        "flash_subtitle": "Cambian cada pocas horas"
      },
      "blocks": [
        { "type": "cell", "settings": { "title": "Combos", "subtitle": "Arma tu dúo y ahorra" } },
        { "type": "cell", "settings": { "title": "Liquidación", "subtitle": "Últimas unidades" } },
        { "type": "cell", "settings": { "title": "Testers", "subtitle": "Originales a menor precio" } }
      ]
    }
  ]
}
{% endschema %}
